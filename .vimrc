inoremap jj <Esc>
vnoremap jj <Esc>
set handler <C-s> a:ide
set clipboard=unnamedplus
set clipboard+=ideaput
set keep-english-in-normal-and-restore-in-insert
noremap <Up> <Nop>
noremap <Down> <Nop>
noremap <Left> <Nop>
noremap <Right> <Nop>
inoremap <Up> <Nop>
inoremap <Down> <Nop>
inoremap <Left> <Nop>
inoremap <Right> <Nop>