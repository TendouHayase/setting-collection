{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "gdb: 현재 파일 디버그",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\build\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
      "preLaunchTask": "g++: debug build active file",
      "setupCommands": [
        {
          "description": "STL pretty-printing 활성화",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "구조체 필드를 줄바꿈해서 출력",
          "text": "set print pretty on",
          "ignoreFailures": true
        }
      ]
    },
