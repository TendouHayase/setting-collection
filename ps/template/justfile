set shell := ["bash", "-uc"]
set windows-shell := ["C:/msys64/usr/bin/bash.exe", "-cu"]

default: (stress "1000")

# 일반 스트레스 테스트
stress count="1000":
    bash ./stress.sh {{count}}

# 새니타이저 동반 (clang64 환경 필요, 느리므로 횟수를 줄임)
san count="300":
    SAN=1 CXX=clang++ bash ./stress.sh {{count}}

# 특정 시드 이후부터 재개
resume start count="1000":
    bash ./stress.sh {{count}} {{start}}

# 반례 재현
repro seed:
    ./gen {{seed}} > in.txt
    ./main < in.txt

# 새 문제 디렉터리 생성
new name:
    mkdir -p {{name}}
    cp gen.cpp brute.cpp main.cpp stress.sh justfile {{name}}/

clean:
    rm -f main main.exe brute brute.exe gen gen.exe in.txt out_main.txt out_brute.txt
